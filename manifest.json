{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "default_locale": "en",
  "version": "1.14.2",
  "description": "__MSG_description__",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "__MSG_actionTitle__", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" } }
  },
  "omnibox": { "keyword": "m" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "favicon", "tabs", "tabGroups", "sessions", "sidePanel"],
  "optional_permissions": ["bookmarks", "history"],
  "host_permissions": ["https://www.bing.com/*"]
}
