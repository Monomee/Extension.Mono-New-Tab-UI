{
  "manifest_version": 3,
  "name": "Mono New Tab",
  "version": "1.6.0",
  "description": "Trang New Tab kiểu màn hình chính iPad: lưới widget, dock truy cập nhanh, ảnh nền tùy chọn.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage", "favicon"],
  "host_permissions": ["https://www.bing.com/*"]
}
